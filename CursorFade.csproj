<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UIA 泛用 tooltip 探测需要 System.Windows.Automation（UIAutomationClient 属 WPF 桌面引用集） -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CursorFade</AssemblyName>
    <RootNamespace>CursorFade</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <!-- 交付目录固定为主桌面：每次发布直接产出可交付程序到桌面 -->
    <PublishDir>C:\Users\hasee\Desktop\CursorFade\</PublishDir>
    <!-- 交付成品：自包含（目标机器无需安装 .NET 运行时即可运行） -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- UseWPF 后隐式 using 集合不含 System.IO，补回（BinaryWriter/MemoryStream 等） -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
